import pandas as pd
import numpy as np
from sklearn.ensemble import IsolationForest
from sklearn.preprocessing import StandardScaler
from datetime import datetime
import time

class FraudDetectionSystem:
    def __init__(self):
        # Initialize ML model and scaler
        self.model = IsolationForest(n_estimators=100, 
                                   contamination=0.01, 
                                   random_state=42)
        self.scaler = StandardScaler()
        self.threshold = -0.6  # Threshold for flagging anomalies
        self.transaction_history = pd.DataFrame()
        
    def preprocess_data(self, new_transactions):
        """Clean and prepare transaction data for analysis"""
        # Convert timestamp to numerical features
        new_transactions['hour'] = new_transactions['timestamp'].dt.hour
        new_transactions['day_of_week'] = new_transactions['timestamp'].dt.dayofweek
        
        # Calculate velocity features
        new_transactions['amt_per_hr'] = new_transactions.groupby(
            'user_id')['amount'].transform(lambda x: x.rolling('1H').mean())
        
        # Select relevant features
        features = ['amount', 'hour', 'day_of_week', 'amt_per_hr',
                   'merchant_category', 'location_variance']
        
        return new_transactions[features]
    
    def train_model(self, historical_data):
        """Train the anomaly detection model"""
        # Preprocess historical data
        processed_data = self.preprocess_data(historical_data)
        
        # Scale features
        self.scaler.fit(processed_data)
        scaled_data = self.scaler.transform(processed_data)
        
        # Train model
        self.model.fit(scaled_data)
        print("Model training completed successfully")
        
    def analyze_transaction(self, transaction):
        """Analyze a single transaction in real-time"""
        # Convert to DataFrame for processing
        trans_df = pd.DataFrame([transaction])
        
        # Preprocess and scale
        processed = self.preprocess_data(trans_df)
        scaled = self.scaler.transform(processed)
        
        # Predict anomaly score
        anomaly_score = self.model.decision_function(scaled)[0]
        
        # Determine if fraudulent
        is_fraud = anomaly_score < self.threshold
        
        return {
            'transaction_id': transaction['transaction_id'],
            'anomaly_score': anomaly_score,
            'is_fraud': is_fraud,
            'timestamp': datetime.now()
        }
    
    def monitor_transactions(self, real_time_stream):
        """Continuous monitoring of transaction stream"""
        while True:
            new_transactions = real_time_stream.get_new_transactions()
            
            for _, trans in new_transactions.iterrows():
                result = self.analyze_transaction(trans)
                
                if result['is_fraud']:
                    self.flag_fraudulent_transaction(result)
                    self.trigger_alert(trans)
                
                # Update transaction history
                self.update_history(trans, result)
            
            time.sleep(1)  # Adjust based on throughput needs
    
    def flag_fraudulent_transaction(self, fraud_result):
        """Handle flagged fraudulent transactions"""
        print(f"🚨 Fraud Alert! Transaction ID: {fraud_result['transaction_id']}")
        print(f"Anomaly Score: {fraud_result['anomaly_score']:.2f}")
        # Add to fraud log, block transaction, notify security team, etc.
    
    def trigger_alert(self, transaction):
        """Initiate security protocols for fraud case"""
        # Implement SMS/email alerts to customer
        # Freeze account if needed
        # Notify fraud investigation team
        pass
    
    def update_history(self, transaction, result):
        """Maintain transaction history database"""
        record = {
            **transaction.to_dict(),
            **result
        }
        self.transaction_history = pd.concat([
            self.transaction_history,
            pd.DataFrame([record])
        ], ignore_index=True)


