if __name__ == "__main__":
    # Initialize system
    fraud_system = FraudDetectionSystem()
    
    # Load historical data for training
    historical_transactions = pd.read_csv('historical_transactions.csv')
    historical_transactions['timestamp'] = pd.to_datetime(historical_transactions['timestamp'])
    fraud_system.train_model(historical_transactions)
    
    # Simulate real-time monitoring
    class TransactionStream:
        def __init__(self):
            self.sample_transactions = pd.read_csv('sample_transactions.csv')
            self.sample_transactions['timestamp'] = pd.to_datetime(
                self.sample_transactions['timestamp'])
            self.index = 0
        
        def get_new_transactions(self):
            # Return batch of 5 transactions
            batch = self.sample_transactions.iloc[self.index:self.index+5]
            self.index += 5
            return batch
    
    stream = TransactionStream()
    fraud_system.monitor_transactions(stream)
